# Server configuration
PORT=8000
FRONTEND_URL=https://alhayat-ai-restaurant-backend.onrender.com

# Database (MongoDB Atlas connection string)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?appName=Cluster0

# Authentication & AI Keys
JWT_SECRET=your_jwt_secret_here
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_CLIENT_ID=your_google_client_id_here
OPENAI_API_KEY=your_openai_key_optional

# Razorpay Test Mode Credentials (NEVER expose the secret on the frontend)
RAZORPAY_MODE=TEST
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_test_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
